<main>

  <!-- Hero Slideshow -->
  <section class="hero">

    <!-- SLIDES — to add your photos, drop image files into images/hero/
         then replace each slide-placeholder div with: <img src="images/hero/your-filename.jpg" alt="description"> -->
    <div class="hero-slides">

      <div class="hero-slide active">
        <img src="images/projects/red-coat-hill-04.jpg" alt="Red Coat Hill — dining room looking out to the meadow">
      </div>

      <div class="hero-slide">
        <img src="images/hero/hero-14.jpg" alt="Pond House — marsh porch">
      </div>

      <div class="hero-slide">
        <img src="images/projects/runner-road-hero.jpg" alt="Runner Road">
      </div>

      <div class="hero-slide">
        <img src="images/hero/hero-5.jpg" alt="White Feather — Joshua Tree">
      </div>

    </div>

    <!-- Dark gradient so text is always legible over photos -->
    <div class="hero-overlay"></div>

    <!-- Text content -->
    <div class="hero-content">
      <h1>Light on the land</h1>
      <p class="hero-subtext">Architecture and Nature in Harmony</p>
    </div>

    <!-- Dot indicators -->
    <div class="hero-dots">
      <button class="hero-dot active" aria-label="Slide 1"></button>
      <button class="hero-dot" aria-label="Slide 2"></button>
      <button class="hero-dot" aria-label="Slide 3"></button>
      <button class="hero-dot" aria-label="Slide 4"></button>
    </div>

  </section>

  <!-- Project Grid -->
  <section id="projects" class="section">
    <div class="section-inner">
      <div class="section-header">
        <span class="label">Selected Work</span>
      </div>

      <div class="filter-meta">
        <span class="filter-count"></span>
        <span><button type="button" class="filter-reset" hidden>Clear filters</button><span class="filter-sep" hidden> &nbsp;&middot;&nbsp; </span><button type="button" class="filter-toggle" aria-expanded="false" aria-controls="project-filters">Filter</button> &nbsp;&middot;&nbsp; <a href="map.html" style="border-bottom:1px solid #c8c2b8;padding-bottom:1px;">See the map</a></span>
      </div>
      <!-- Filters: chips read the data-* attributes on each card below.
           Closed until the Filter button opens them. A link that carries a
           selection (?status=construction) opens them on arrival, so nobody
           is looking at a filtered grid with no sign of why. -->
      <div class="filter-bar project-filters" id="project-filters" role="group" aria-label="Filter projects" hidden>
        <div class="filter-group">
          <span class="label">Type</span>
          <button type="button" class="filter-chip active" data-group="type" data-value="all" aria-pressed="true">All</button>
          <button type="button" class="filter-chip" data-group="type" data-value="residential">Residential</button>
          <button type="button" class="filter-chip" data-group="type" data-value="renovation">Renovation & Addition</button>
          <button type="button" class="filter-chip" data-group="type" data-value="preservation">Historic Preservation</button>
          <button type="button" class="filter-chip" data-group="type" data-value="interior">Interior Design</button>
          <button type="button" class="filter-chip" data-group="type" data-value="cultural">Museum & Cultural</button>
          <button type="button" class="filter-chip" data-group="type" data-value="commercial">Commercial</button>
        </div>
        <div class="filter-group">
          <span class="label">Status</span>
          <button type="button" class="filter-chip active" data-group="status" data-value="all" aria-pressed="true">All</button>
          <button type="button" class="filter-chip" data-group="status" data-value="complete">Complete</button>
          <button type="button" class="filter-chip" data-group="status" data-value="construction">In Construction</button>
          <button type="button" class="filter-chip" data-group="status" data-value="design">In Design</button>
        </div>
        <div class="filter-group">
          <span class="label">Place</span>
          <button type="button" class="filter-chip active" data-group="region" data-value="all" aria-pressed="true">All</button>
          <button type="button" class="filter-chip" data-group="region" data-value="vineyard">Martha's Vineyard</button>
          <button type="button" class="filter-chip" data-group="region" data-value="massachusetts">Massachusetts</button>
          <button type="button" class="filter-chip" data-group="region" data-value="maine">Maine</button>
          <button type="button" class="filter-chip" data-group="region" data-value="newyork">New York</button>
          <button type="button" class="filter-chip" data-group="region" data-value="california">California</button>
        </div>
      </div>

      <div class="project-grid">

{%- for p in projects %}{% if p.inGrid %}
        <a href="{{ p.page | a }}" class="project-card" data-types="{{ p.card.types | join(" ") | a }}" data-status="{{ p.card.status | a }}" data-region="{{ p.card.region | regions | join(" ") | a }}">
          <div class="project-card-img">
            {% if p.card.image %}<img src="{{ p.card.image | a }}" alt="{{ p.card.alt | a }}">{% else %}<div class="placeholder-img">{{ p.card.name | t }}</div>{% endif %}
          </div>
          <div class="project-card-meta">
            <h3>{{ p.card.name | t }}</h3>
            <span class="location">{{ p.card.location | t }}</span>
            <span class="status status-{{ p.card.status | a }}">{{ taxonomy.STATUS[p.card.status] | t }}</span>
          </div>
        </a>
{% endif %}{%- endfor %}
      </div>
      <p class="filter-empty" hidden>Nothing matches that combination yet.</p>
    </div>
  </section>

  <!-- About Teaser -->
  <section class="section" style="background:#faf8f6; border-top:1px solid #ebebeb; border-bottom:1px solid #ebebeb;">
    <div class="section-inner">
      <div class="about-teaser">
        <div class="about-teaser-text">
          <span class="label">The Practice</span>
          <div class="divider"></div>
          <h2>Light on the land &mdash; and built to last</h2>
          <div class="divider"></div>
          <p>Auerbach Architecture serves residential, museum, and commercial clients across Martha's Vineyard, Cambridge, New York City, the Hamptons, Vermont, and Maine.</p>
          <p>Our practice is guided by a belief that architecture should honor its site, serve its inhabitants, and tread lightly on the land.</p>
          <a href="about.html" style="display:inline-block;margin-top:2rem;font-size:0.65rem;letter-spacing:0.2em;text-transform:uppercase;border-bottom:1px solid #1c1c1c;padding-bottom:2px;">Learn More</a>
        </div>
        <div class="about-teaser-img">
          <img src="images/team/team.jpg" alt="Auerbach Architecture Team" style="width:100%;height:108%;object-fit:cover;margin-top:-8%;">
        </div>
      </div>
    </div>
  </section>

</main>

